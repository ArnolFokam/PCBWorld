[submodule "engine"]
	path = engine
	# The engine is a separate GPLv3 program in its own repository. Nothing under
	# engine/ is tracked or distributed here — only this pointer.
	url = git@github.com:ArnolFokam/PCBWorld-Engine.git
	branch = pcb-routing-explore
	shallow = true
	ignore = dirty

[submodule "agents/verl-agent"]
	path = external/verl-agent
	url = https://github.com/langfengQ/verl-agent.git
	ignore = dirty
[submodule "external/OrthoRoute"]
	path = external/OrthoRoute
	url = https://github.com/bbenchoff/OrthoRoute.git
	ignore = dirty
